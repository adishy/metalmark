# Secrets / env
.env
.env.*
!.env.example
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / frontend
node_modules/
frontend/dist/
.vite/
*.local

# Databases / backups
*.sqlite3
*.dump
pg_backups/

# Deployment: Caddy's local CA, exported so a client can be made to trust it
# (ADR-0038). Per-install, never shared — a committed copy would be a private
# key's public half sitting in a repo, and trusting the wrong root is worse than
# trusting none.
metalmark-ca.crt

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# The `prod` gate's host-path half: a scratch tree under the repo (ADR-0040). It
# removes its own directories, so this only matters when a run is killed
# partway — and what is left behind then is a Postgres data directory, which is
# not something to discover with `git status`.
.prod-paths.*/

# Test / coverage
coverage/
htmlcov/
.coverage
playwright-report/
test-results/
