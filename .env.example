# Kestrel environment (copy to .env for local dev; NEVER commit .env)
# ---------------------------------------------------------------------------
# Postgres
POSTGRES_USER=kestrel
POSTGRES_PASSWORD=kestrel_dev_only_change_me
POSTGRES_DB=kestrel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# The application connects as a NON-superuser role that does NOT bypass RLS.
# (created by the bootstrap migration; see ADR-0014 tenant isolation)
APP_DB_USER=kestrel_app
APP_DB_PASSWORD=kestrel_app_dev_only_change_me

# API
KESTREL_ENV=dev
KESTREL_LOG_LEVEL=INFO
# Session cookie lifetime
KESTREL_SESSION_IDLE_MINUTES=1440
KESTREL_SESSION_ABSOLUTE_HOURS=720

# Base currency for the (single) household in dev seeds. Immutable once set (ADR-0017).
KESTREL_DEFAULT_BASE_CURRENCY=USD

# KESTREL_SECRET_KEY is NOT set here. It is loaded from a docker secret file
# (secrets/kestrel_secret_key) — env vars leak via `docker inspect` (see ARCHITECTURE §5).
# For non-docker local runs, point KESTREL_SECRET_KEY_FILE at a file.
KESTREL_SECRET_KEY_FILE=/run/secrets/kestrel_secret_key

# Frontend (Vite) — proxied to /api in dev
VITE_API_BASE=/api
