# MetalMark environment (copy to .env for local dev; NEVER commit .env)
# ---------------------------------------------------------------------------
# Postgres
POSTGRES_USER=metalmark
POSTGRES_PASSWORD=metalmark_dev_only_change_me
POSTGRES_DB=metalmark
POSTGRES_HOST=db
POSTGRES_PORT=5432

# The application connects as a NON-superuser role that does NOT bypass RLS.
# (created by the bootstrap migration; see ADR-0014 tenant isolation)
APP_DB_USER=metalmark_app
APP_DB_PASSWORD=metalmark_app_dev_only_change_me

# API
METALMARK_ENV=dev
METALMARK_LOG_LEVEL=INFO
# Session cookie lifetime
METALMARK_SESSION_IDLE_MINUTES=1440
METALMARK_SESSION_ABSOLUTE_HOURS=720

# Base currency for the (single) household in dev seeds. Immutable once set (ADR-0017).
METALMARK_DEFAULT_BASE_CURRENCY=USD

# METALMARK_SECRET_KEY is NOT set here. It is loaded from a docker secret file
# (secrets/metalmark_secret_key) — env vars leak via `docker inspect` (see ARCHITECTURE §5).
# For non-docker local runs, point METALMARK_SECRET_KEY_FILE at a file.
METALMARK_SECRET_KEY_FILE=/run/secrets/metalmark_secret_key

# Frontend (Vite) — proxied to /api in dev
VITE_API_BASE=/api
